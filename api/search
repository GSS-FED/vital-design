age size or result count changes in your screen's state."},"2344":{"id":"/docs/components/pagination-29","page_id":"/docs/components/pagination","tags":[],"type":"text","url":"/docs/components/pagination#pagination-paginationcontent-and-paginationitem","content":"These render nav, ul, and li respectively, forward native props and refs, and accept className. Pagination defaults to aria-label=\"pagination\"; give each navigation landmark a distinct label when a page contains multiple paginators."},"2345":{"id":"/docs/components/pagination-30","page_id":"/docs/components/pagination","tags":[],"type":"text","url":"/docs/components/pagination#paginationlink","content":"Prop"},"2346":{"id":"/docs/components/pagination-31","page_id":"/docs/components/pagination","tags":[],"type":"text","url":"/docs/components/pagination#paginationlink","content":"Type"},"2347":{"id":"/docs/components/pagination-32","page_id":"/docs/components/pagination","tags":[],"type":"text","url":"/docs/components/pagination#paginationlink","content":"Default"},"2348":{"id":"/docs/components/pagination-33","page_id":"/docs/components/pagination","tags":[],"type":"text","url":"/docs/components/pagination#paginationlink","content":"Description"},"2349":{"id":"/docs/components/pagination-34","page_id":"/docs/components/pagination","tags":[],"type":"text","url":"/docs/components/pagination#paginationlink","content":"href"},"2350":{"id":"/docs/components/pagination-35","page_id":"/docs/components/pagination","tags":[],"type":"text","url":"/docs/components/pagination#paginationlink","content":"string"},"2351":{"id":"/docs/components/pagination-36","page_id":"/docs/components/pagination","tags":[],"type":"text","url":"/docs/components/pagination#paginationlink","content":"—"},"2352":{"id":"/docs/components/pagination-37","page_id":"/docs/components/pagination","tags":[],"type":"text","url":"/docs/components/pagination#paginationlink","content":"Destination for the default anchor"},"2353":{"id":"/docs/componen