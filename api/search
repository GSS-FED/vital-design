ype":"heading","tags":[],"url":"/docs/components/toast#anchored-toasts","content":"Anchored toasts"},"2596":{"id":"/docs/components/toast-14","page_id":"/docs/components/toast","type":"heading","tags":[],"url":"/docs/components/toast#props","content":"Props"},"2597":{"id":"/docs/components/toast-15","page_id":"/docs/components/toast","type":"heading","tags":[],"url":"/docs/components/toast#toastprovider","content":"ToastProvider"},"2598":{"id":"/docs/components/toast-16","page_id":"/docs/components/toast","type":"heading","tags":[],"url":"/docs/components/toast#anchoredtoastprovider","content":"AnchoredToastProvider"},"2599":{"id":"/docs/components/toast-17","page_id":"/docs/components/toast","type":"heading","tags":[],"url":"/docs/components/toast#manager-methods","content":"Manager methods"},"2600":{"id":"/docs/components/toast-18","page_id":"/docs/components/toast","type":"heading","tags":[],"url":"/docs/components/toast#add-options","content":"Add options"},"2601":{"id":"/docs/components/toast-19","page_id":"/docs/components/toast","type":"heading","tags":[],"url":"/docs/components/toast#createtoastmanager","content":"createToastManager"},"2602":{"id":"/docs/components/toast-20","page_id":"/docs/components/toast","type":"heading","tags":[],"url":"/docs/components/toast#exports","content":"Exports"},"2603":{"id":"/docs/components/toast-21","page_id":"/docs/components/toast","tags":[],"type":"text","url":"/docs/components/toast#usage","content":"Toast is built on Base UI's\nToast. The package\nexports a module-level singleton toastManager and a ToastProvider\nthat auto-mounts the viewport — drop <ToastProvider> once at the app\nroot and call toastManager.add(...) from anywhere (event handlers,\nfetch interceptors, zustand actions, …). No hook required at the call\nsite."},"2604":{"id":"/docs/components/toast-22","page_id":"/docs/components/toast","tags":[],"type":"text","url":"/docs/components/toast#status","content":"type accepts success, warning, error, info, or loading.\nThe toast applies the matching colour but does not pick an icon —\nicons are opt-in via data.icon. The loading status swaps the\nclose X for a cancel button when data.cancelProps is supplied."},"2605":{"id":"/docs/components/toast-23","page_id":"/docs/components/toast","tags":[],"type":"text","url":"/docs/components/toast#position","content":"ToastProvider accepts a position prop with six anchors:\ntop-left, top-center, top-right, bottom-left, bottom-center,\nbottom-right. One provider serves one position — toasts dispatched\nthrough its manager render at that anchor."},"2606":{"id":"/docs/components/toast-24","page_id":"/docs/components/toast","tags":[],"type":"text","url":"/docs/components/toast#multiple-positions-two-channels","content":"To send some toasts to one corner and others to a different corner,\ncreate a second manager with createToastManager and nest a second\nToastProvider for it. Each provider/manager pair is a separate\nchannel — pick whichever you want at the call site."},"2607":{"id":"/docs/components/toast-25","page_id":"/docs/components/toast","tags":[],"type":"text","url":"/docs/components/toast#variants","content":"The solid variant (default) fills the toast with the status colour\non a white-on-coloured layout. The subtle variant flips to a white\nsurface with a tinted icon — matches the \"notification\" pattern in the\ndesign system."},"2608":{"id":"/docs/components/toast-26","page_id":"/docs/components/toast","tags":[],"type":"text","url":"/docs/components/toast#loading","content":"For long-running operations, dispatch a toast with type: 'loading'\nand timeout: 0. Pair it with actionProps and a data.cancelProps\nbutton (instead of the close X) so the user can cancel the operation,\nthen update the toast on completion."},"2609":{"id":"/docs/components/toast-27","page_id":"/docs/components/toast","tags":[],"type":"text","url":"/docs/components/toast#with-icon","content":"Pass any icon node through data.icon; the renderer drops it into\nthe icon slot before the title."},"2610":{"id":"/docs/components/toast-28","page_id":"/docs/components/toast","tags":[],"type":"text","url":"/docs/components/toast#with-description","content":"Add a second line of context with description."},"2611":{"id":"/docs/components/toast-29","page_id":"/docs/components/toast","tags":[],"type":"text","url":"/docs/components/toast#with-action","content":"actionProps is forwarded to the action button. Use it for an \"Undo\"\nor other recovery affordance."},"2612":{"id":"/docs/components/toast-30","page_id":"/docs/components/toast","tags":[],"type":"text","url":"/docs/components/toast#promise","content":"promise swaps a single toast through loading, success, and error\nstates based on a promise."},"2613":{"id":"/docs/components/toast-31","page_id":"/docs/components/toast","tags":[],"type":"text","url":"/docs/components/toast#anchored-toasts","content":"For tooltip-style feedback anchored to a specific element (e.g.,\n\"Copied!\" near a button), use anchoredToastManager and wrap with\nAnchoredToastProvider. Pass positionerProps.anchor per call."},"2614":{"id":"/docs/components/toast-32","page_id":"/docs/components/toast","tags":[],"type":"text","url":"/docs/components/toast#toastprovider","content":"Prop"},"2615":{"id":"/docs/components/toast-33","page_id":"/docs/components/toast","tags":[],"type":"text","url":"/docs/components/toast#toastprovider","content":"Type"},"2616":{"id":"/docs/components/toast-34","page_id":"/docs/components/toast","tags":[],"type":"text","url":"/docs/components/toast#toastprovider","content":"Default"},"2617":{"id":"/docs/components/toast-35","page_id":"/docs/components/toast","tags":[],"type":"text","url":"/docs/components/toast#toastprovider","content":"Description"},"2618":{"id":"/docs/components/toast-36","page_id":"/docs/components/toast","tags":[],"type":"text","url":"/docs/components/toast#toastprovider","content":"position"},"2619":{"id":"/docs/components/toast-37","page_id":"/docs/component