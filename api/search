/docs/getting-started/tailwind-setup"},"3246":{"id":"/docs/getting-started/tailwind-setup-0","page_id":"/docs/getting-started/tailwind-setup","tags":[],"type":"text","url":"/docs/getting-started/tailwind-setup","content":"Configure Tailwind CSS 4 to work with Vital Design components and design tokens."},"3247":{"id":"/docs/getting-started/tailwind-setup-1","page_id":"/docs/getting-started/tailwind-setup","type":"heading","tags":[],"url":"/docs/getting-started/tailwind-setup#overview","content":"Overview"},"3248":{"id":"/docs/getting-started/tailwind-setup-2","page_id":"/docs/getting-started/tailwind-setup","type":"heading","tags":[],"url":"/docs/getting-started/tailwind-setup#registry-installed-local-components","content":"Registry-Installed Local Components"},"3249":{"id":"/docs/getting-started/tailwind-setup-3","page_id":"/docs/getting-started/tailwind-setup","type":"heading","tags":[],"url":"/docs/getting-started/tailwind-setup#design-tokens","content":"Design Tokens"},"3250":{"id":"/docs/getting-started/tailwind-setup-4","page_id":"/docs/getting-started/tailwind-setup","type":"heading","tags":[],"url":"/docs/getting-started/tailwind-setup#postcss-configuration","content":"PostCSS Configuration"},"3251":{"id":"/docs/getting-started/tailwind-setup-5","page_id":"/docs/getting-started/tailwind-setup","type":"heading","tags":[],"url":"/docs/getting-started/tailwind-setup#fonts","content":"Fonts"},"3252":{"id":"/docs/getting-started/tailwind-setup-6","page_id":"/docs/getting-started/tailwind-setup","type":"heading","tags":[],"url":"/docs/getting-started/tailwind-setup#style-isolation-with-data-slot","content":"Style isolation with data-slot"},"3253":{"id":"/docs/getting-started/tailwind-setup-7","page_id":"/docs/getting-started/tailwind-setup","type":"heading","tags":[],"url":"/docs/getting-started/tailwind-setup#naming","content":"Naming"},"3254":{"id":"/docs/getting-started/tailwind-setup-8","page_id":"/docs/getting-started/tailwind-setup","type":"heading","tags":[],"url":"/docs/getting-started/tailwind-setup#scoping-styles-in-your-app","content":"Scoping styles in your app"},"3255":{"id":"/docs/getting-started/tailwind-setup-9","page_id":"/docs/getting-started/tailwind-setup","type":"heading","tags":[],"url":"/docs/getting-started/tailwind-setup#which-parts-get-a-slot","content":"Which parts get a slot?"},"3256":{"id":"/docs/getting-started/tailwind-setup-10","page_id":"/docs/getting-started/tailwind-setup","type":"heading","tags":[],"url":"/docs/getting-started/tailwind-setup#coverage-status","content":"Coverage status"},"3257":{"id":"/docs/getting-started/tailwind-setup-11","page_id":"/docs/getting-started/tailwind-setup","tags":[],"type":"text","url":"/docs/getting-started/tailwind-setup#overview","content":"This page applies to registry-installed Vital Design components. When you install src-v2/ components through the shadcn-compatible registry, the CLI copies them into your app and injects the Vital Design theme tokens plus small base CSS rules into the CSS file configured in components.json."},"3258":{"id":"/docs/getting-started/tailwind-setup-12","page_id":"/docs/getting-started/tailwind-setup","tags":[],"type":"text","url":"/docs/getting-started/tailwind-setup#overview","content":"If you are maintaining an existing project that still uses the published @fed/vital-design npm package, keep that legacy src/ integration as-is. The npm package does not expose the registry-only src-v2 stylesheet as a public import."},"3259":{"id":"/docs/getting-started/tailwind-setup-13","page_id":"/docs/getting-started/tailwind-setup","tags":[],"type":"text","url":"/docs/getting-started/tailwind-setup#registry-installed-local-components","content":"In the global CSS file configured in your components.json (for example app/globals.css in Next.js), keep the Tailwind import:"},"3260":{"id":"/docs/getting-started/tailwind-setup-14","page_id":"/docs/getting-started/tailwind-setup","tags":[],"type":"text","url":"/docs/getting-started/tailwind-setup#registry-installed-local-components","content":"When you install a Vital Design component from the registry, shadcn also installs the @vital-design/vital-theme dependency and writes the required CSS variables, Tailwind theme tokens, and Vital Design base rules into that CSS file for you."},"3261":{"id":"/docs/getting-started/tailwind-setup-15","page_id":"/docs/getting-started/tailwind-setup","tags":[],"type":"text","url":"/docs/getting-started/tailwind-setup#registry-installed-local-components","content":"Because the copied component files live inside your app source tree, Tailwind CSS 4 will usually detect them automatically. In the common app/ or src/ setup, you do not need an extra @source line for registry-installed components."},"3262":{"id":"/docs/getting-started/tailwind-setup-16","page_id":"/docs/getting-started/tailwind-setup","tags":[],"type":"text","url":"/docs/getting-started/tailwind-setup#registry-installed-local-components","content":"If your components.json points to a custom directory outside Tailwind's automatic source detection, add an @source rule that matches your local component path."},"3263":{"id":"/docs/getting-started/tailwind-setup-17","page_id":"/docs/getting-started/tailwind-setup","tags":[],"type":"text","url":"/docs/getting-started/tailwind-setup#design-tokens","content":"Registry installs expose the Vital Design design tokens as CSS custom properties and Tailwind utilities. The shadcn flow writes the required theme variables and the not-disabled custom variant into your configured global CSS file for you."},"3264":{"id":"/docs/getting-started/tailwind-setup-18","page_id":"/docs/getting-started/tailwind-setup","tags":[],"type":"text","url":"/docs/getting-started/tailwind-setup#design-tokens","content":"For example, the following tokens become available:"},"3265":{"id":"/docs/getting-started/tailwind-setup-19","page_id":"/docs/getting-started/tailwind-setup","tags":[],"type":"text","url":"/docs/getting-started/tailwind-setup#design-tokens","content":"These are exposed as Tailwind color utilities via @theme inline:"},"3266":{"id":"/docs/getting-started/tailwind-setup-20","page_id":"/docs/getting-started/tailwind-setup","tags":[],"type":"text","url":"/docs/getting-started/tailwind-setup#postcss-configuration","content":"Tailwind CSS 4 requires @tailwindcss/postcss. Create or update postcss.config.js (or postcss.config.cjs, depending on your project) like this:"},"3267":{"id":"/docs/getting-started/tailwind-setup-21","page_id":"/docs/getting-started/tailwind-setup","tags":[],"type":"text","url":"/docs/getting-started/tailwind-setup#postcss-configuration","content":"If your project already uses autoprefixer, you can keep it."},"3268":{"id":"/docs/getting-started/tailwind-setup-22","page_id":"/docs/getting-started/tailwind-setup","tags":[],"type":"text","url":"/docs/getting-started/tailwind-setup#fonts","content":"Vital Design uses the following font stack (defined in --font-sans):"},"3269":{"id":"/docs/getting-started/tailwind-setup-23","page_id":"/docs/getting-started/tailwind-setup","tags":[],"type":"text","url":"/docs/getting-started/tailwind-setup#fonts","content":"To load Roboto, add it to your HTML or import via a font provider. With Next.js:"},"3270":{"id":"/docs/getting-started/tailwind-setup-24","page_id":"/docs/getting-started/tailwind-setup","tags":[],"type":"text","url":"/docs/getting-started/tailwind-setup#style-isolation-with-data-slot","content":"Vital Design components expose stable data-slot attributes on their styled DOM parts. Use these hooks to scope Tailwind utilities and custom CSS so VD styles do not leak into your app's native elements (and vice versa)."},"3271":{"id":"/docs/getting-started/tailwind-setup-25","page_id":"/docs/getting-started/tailwind-setup","tags":[],"type":"text","url":"/docs/getting-started/tailwind-setup#style-isolation-with-data-slot","content":"This aligns with the shadcn data-slot convention: every DOM surface gets a predictable selector."},"3272":{"id":"/docs/getting-started/tailwind-setup-26","page_id":"/docs/getting-started/tailwind-setup","tags":[],"type":"text","url":"/docs/getting-started/tailwind-setup#naming","content":"Part"},"3273":{"id":"/docs/getting-started/tailwind-setup-27","page_id":"/docs/getting-started/tailwind-setup","tags":[],"type":"text","url":"/docs/getting-started/tailwind-setup#naming","content":"data-slot value"},"3274":{"id":"/docs/getting-started/tailwind-setup-28","page_id":"/docs/getting-started/tailwind-setup","tags":[],"type":"text","url":"/docs/getting-started/tailwind-setup#naming","content":"Example element"},"3275":{"id":"/docs/getting-started/tailwind-setup-29","page_id":"/docs/getting-started/tailwind-setup","tags":[],"type":"text","url":"/docs/getting-started/tailwind-setup#naming","content":"Root"},"3276":{"id":"/docs/getting-started/tailwind-setup-30","page_id":"/docs/getting-started/tailwind-setup","tags":[],"type":"text","url":"/docs/getting-started/tailwind-setup#naming","content":"{component}"},"3277":{"id":"/docs/getting-started/tailwind-setup-31","page_id":"/docs/getting-started/tailwind-setup","tags":[],"type":"text","url":"/docs/getting-started/tailwind-setup#naming","content":"data-slot=\"button\""},"3278":{"id":"/docs/getting-started/tailwind-setup-32","page_id":"/docs/getting-started/tailwind-setup","tags":[],"type":"text","url":"/docs/getting-started/tailwind-setup#naming","content":"Subpart"},"3279":{"id":"/docs/getting-started/tailwind-setup-33","page_id":"/docs/getting-started/tailwind-setup","tags":[],"type":"text","url":"/docs/getting-started/tailwind-setup#naming","content":"{component}-{part}"},"3280":{"id":"/docs/getting-started/tailwind-setup-34","page_id":"/docs/getting-started/tailwind-setup","tags":[],"type":"text","url":"/docs/getting-started/tailwind-setup#naming","content":"data-slot=\"select-trigger\""},"3281":{"id":"/docs/getting-started/tailwind-setup-35","page_id":"/docs/getting-started/tailwind-setup","tags":[],"type":"text","url":"/docs/g