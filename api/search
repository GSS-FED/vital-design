on."},"1530":{"id":"/docs/components/calendar","page_id":"/docs/components/calendar","type":"page","content":"Calendar","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/calendar"},"1531":{"id":"/docs/components/calendar-0","page_id":"/docs/components/calendar","tags":[],"type":"text","url":"/docs/components/calendar","content":"Date picker calendar built on react-day-picker. Single, range, and multi-select modes with full classNames and components overrides."},"1532":{"id":"/docs/components/calendar-1","page_id":"/docs/components/calendar","type":"heading","tags":[],"url":"/docs/components/calendar#preview","content":"Preview"},"1533":{"id":"/docs/components/calendar-2","page_id":"/docs/components/calendar","type":"heading","tags":[],"url":"/docs/components/calendar#usage","content":"Usage"},"1534":{"id":"/docs/components/calendar-3","page_id":"/docs/components/calendar","type":"heading","tags":[],"url":"/docs/components/calendar#range-selection","content":"Range Selection"},"1535":{"id":"/docs/components/calendar-4","page_id":"/docs/components/calendar","type":"heading","tags":[],"url":"/docs/components/calendar#disabled-dates","content":"Disabled Dates"},"1536":{"id":"/docs/components/calendar-5","page_id":"/docs/components/calendar","type":"heading","tags":[],"url":"/docs/components/calendar#yearmonth-dropdown-caption","content":"Year/Month Dropdown Caption"},"1537":{"id":"/docs/components/calendar-6","page_id":"/docs/components/calendar","type":"heading","tags":[],"url":"/docs/components/calendar#localization","content":"Localization"},"1538":{"id":"/docs/components/calendar-7","page_id":"/docs/components/calendar","type":"heading","tags":[],"url":"/docs/components/calendar#locale","content":"Locale"},"1539":{"id":"/docs/components/calendar-8","page_id":"/docs/components/calendar","type":"heading","tags":[],"url":"/docs/components/calendar#locale--formatter","content":"Locale + formatter"},"1540":{"id":"/docs/components/calendar-9","page_id"