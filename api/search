s/button#icon-only","content":"For icon-only buttons, use size=\"icon-md\" or size=\"icon-lg\" and give the\nbutton an aria-label."},"1060":{"id":"/docs/components/button-23","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button#loading-state","content":"Render a spinner as a child icon and disable the button while work is in flight."},"1061":{"id":"/docs/components/button-24","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button#states","content":"Disable a button with disabled. Add focusableWhenDisabled to keep it in the\ntab order, for example when a tooltip explains why it is disabled."},"1062":{"id":"/docs/components/button-25","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button#link","content":"Use LinkButton for navigation that should look like a button. It renders an\n<a> with the same variants, themes, and sizes, and keeps link semantics, so\nscreen readers announce it as a link and getByRole('link') finds it."},"1063":{"id":"/docs/components/button-26","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button#link","content":"Do not use <Button nativeButton={false} render={<a />}> for links: Base UI\nadds role=\"button\" to every non-<button> element."},"1064":{"id":"/docs/components/button-27","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button#link","content":"For router links, pass the link element through render:"},"1065":{"id":"/docs/components/button-28","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button#button","content":"Prop"},"1066":{"id":"/docs/components/button-29","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button#button","content":"Type"},"1067":{"id":"/docs/components/button-30","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button#button","cont