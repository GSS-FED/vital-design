-49","page_id":"/docs/blocks/tree-select","tags":[],"type":"text","url":"/docs/blocks/tree-select#files","content":"File"},"298":{"id":"/docs/blocks/tree-select-50","page_id":"/docs/blocks/tree-select","tags":[],"type":"text","url":"/docs/blocks/tree-select#files","content":"Description"},"299":{"id":"/docs/blocks/tree-select-51","page_id":"/docs/blocks/tree-select","tags":[],"type":"text","url":"/docs/blocks/tree-select#files","content":"tree-select.tsx"},"300":{"id":"/docs/blocks/tree-select-52","page_id":"/docs/blocks/tree-select","tags":[],"type":"text","url":"/docs/blocks/tree-select#files","content":"Block entry — trigger, page stack, and search"},"301":{"id":"/docs/blocks/tree-select-53","page_id":"/docs/blocks/tree-select","tags":[],"type":"text","url":"/docs/blocks/tree-select#installation","content":"This installs src/blocks/tree-select/tree-select.tsx and its Command, Popover, and icon dependencies."},"302":{"id":"/docs/design-tokens/colors","page_id":"/docs/design-tokens/colors","type":"page","content":"Colors","breadcrumbs":["Docs","Design Tokens"],"tags":[],"url":"/docs/design-tokens/colors"},"303":{"id":"/docs/design-tokens/colors-0","page_id":"/docs/design-tokens/colors","tags":[],"type":"text","url":"/docs/design-tokens/colors","content":"Vittal Design color system — primitive palettes, semantic aliases, and named component tokens."},"304":{"id":"/docs/design-tokens/colors-1","page_id":"/docs/design-tokens/colors","type":"heading","tags":[],"url":"/docs/design-tokens/colors#overview","content":"Overview"},"305":{"id":"/docs/design-tokens/colors-2","page_id":"/docs/design-tokens/colors","type":"heading","tags":[],"url":"/docs/design-tokens/colors#dark-mode","content":"Dark mode"},"306":{"id":"/docs/design-tokens/colors-3","page_id":"/docs/design-tokens/colors","type":"heading","tags":[],"url":"/docs/design-tokens/colors#what-changes-under-dark","content":"What changes under .dark"},"307":{"id":"/docs/design-tokens/colors-4","page_id":"/docs/design-tokens/colors","type":"heading","tags":[],"url":"/docs/design-tokens/colors#writing-components-for-both-modes","content":"Writing components for both modes"},"308":{"id":"/docs/design-tokens/colors-5","page_id":"/docs/design-tokens/colors","type":"heading","tags":[],"url":"/docs/design-tokens/colors#primary","content":"Primary"},"309":{"id":"/docs/design-tokens/colors-6","page_id":"/docs/design-tokens/colors","type":"heading","tags":[],"url":"/docs/design-tokens/colors#grayscale","content":"Grayscale"},"310":{"id":"/docs/design-tokens/colors-7","page_id":"/docs/design-tokens/colors","type":"heading","tags":[],"url":"/docs/design-tokens/colors#grayscale-opacity","content":"Grayscale (Opacity)"},"311":{"id":"/docs/design-tokens/colors-8","page_id":"/docs/design-tokens/colors","type":"heading","tags":[],"url":"/docs/design-tokens/colors#success","content":"Success"},"312":{"id":"/docs/design-tokens/colors-9","page_id":"/docs/design-tokens/colors","type":"heading","tags":[],"url":"/docs/design-tokens/colors#info","content":"Info"},"313":{"id":"/docs/design-tokens/colors-10","page_id":"/docs/design-tokens/colors","type":"heading","tags":[],"url":"/docs/design-tokens/colors#warning","content":"Warning"},"314":{"id":"/docs/design-tokens/colors-11","page_id":"/docs/design-tokens/colors","type":"heading","tags":[],"url":"/docs/design-tokens/colors#destructive","content":"Destructive"},"315":{"id":"/docs/design-tokens/colors-12","page_id":"/docs/design-tokens/colors","type":"heading","tags":[],"url":"/docs/design-tokens/colors#semantic-tokens","content":"Semantic Tokens"},"316":{"id":"/docs/design-tokens/colors-13","page_id":"/docs/design-tokens/colors","type":"heading","tags":[],"url":"/docs/design-tokens/colors#surfaces","content":"Surfaces"},"317":{"id":"/docs/design-tokens/colors-14","page_id":"/docs/design-tokens/colors","type":"heading","tags":[],"url":"/docs/design-tokens/colors#actions","content":"Actions"},"318":{"id":"/docs/design-tokens/colors-15","page_id":"/docs/design-tokens/colors","type":"heading","tags":[],"url":"/docs/design-tokens/colors#status","content":"Status"},"319":{"id":"/docs/design-tokens/colors-16","page_id":"/docs/design-tokens/colors","type":"heading","tags":[],"url":"/docs/design-tokens/colors#form","content":"Form"},"320":{"id":"/docs/design-tokens/colors-17","page_id":"/docs/design-tokens/colors","type":"heading","tags":[],"url":"/docs/design-tokens/colors#charts","content":"Charts"},"321":{"id":"/docs/design-tokens/colors-18","page_id":"/docs/design-tokens/colors","type":"heading","tags":[],"url":"/docs/design-tokens/colors#sidebar","content":"Sidebar"},"322":{"id":"/docs/design-tokens/colors-19","page_id":"/docs/design-tokens/colors","type":"heading","tags":[],"url":"/docs/design-tokens/colors#vittal-extensions","content":"Vittal Extensions"},"323":{"id":"/docs/design-tokens/colors-20","page_id":"/docs/design-tokens/colors","type":"heading","tags":[],"url":"/docs/design-tokens/colors#avatar-palette","content":"Avatar Palette"},"324":{"id":"/docs/design-tokens/colors-21","page_id":"/docs/design-tokens/colors","type":"heading","tags":[],"url":"/docs/design-tokens/colors#tag-palette","content":"Tag Palette"},"325":{"id":"/docs/design-tokens/colors-22","page_id":"/docs/design-tokens/colors","tags":[],"type":"text","url":"/docs/design-tokens/colors#overview","content":"Vittal Design follows the shadcn/ui\nnaming convention for its semantic layer. Colors are defined under\ntokens/ (Style Dictionary), built into src-v2/styles/tokens/generated.css\nas CSS custom properties on :root, with dark overrides on .dark,\nand exposed to Tailwind via @theme inline (--color-*)."},"326":{"id":"/docs/design-tokens/colors-23","page_id":"/docs/design-tokens/colors","tags":[],"type":"text","url":"/docs/design-tokens/colors#overview","content":"Primitive scales (--primary-50…900, --grayscale-100…900,\n--grayscale-opacity-100…900, --success-100…900, etc.) — internal\nfoundation. Reach for these when you need a specific shade for\ncharts, illustrations, or fine-grained tinting. Tailwind utility:\nbg-primary-500, text-grayscale-700, etc."},"327":{"id":"/docs/design-tokens/colors-24","page_id":"/docs/design-tokens/colors","tags":[],"type":"text","url":"/docs/design-tokens/colors#overview","content":"Semantic tokens (--background, --primary, --card,\n--destructive, …) — the public API. These describe intent\nand pair with -foreground siblings for legible content on the\nsurface. Tailwind utility: bg-primary text-primary-foreground."},"328":{"id":"/docs/design-tokens/colors-25","page_id":"/docs/design-tokens/colors","tags":[],"type":"text","url":"/docs/design-tokens/colors#overview","content":"Component tokens (--avatar-*-fg, --tag-*-solid) — closed\npalettes used by specific components."},"329":{"id":"/docs/design-tokens/colors-26","page_id":"/docs/design-tokens/colors","tags":[],"type":"text","url":"/docs/design-tokens/colors#dark-mode","content":"Add class=\"dark\" to an ancestor, usually <html>. With\nnext-themes, set\nattribute=\"class\". The theme does not follow\nprefers-color-scheme. Reinstall @vital-design/vital-theme so\ncssVars.dark is written into the app stylesheet."},"330":{"id":"/docs/design-tokens/colors-27","page_id":"/docs/design-tokens/colors","tags":[],"type":"text","url":"/docs/design-tokens/colors#dark-mode","content":"Every color swatch on this page shows two values: L is the light\nvalue and D is the dark value. Each chip is drawn on its own\nmode's page color, so translucent values look the way they render."},"331":{"id":"/docs/design-tokens/colors-28","page_id":"/docs/design-tokens/colors","tags":[],"type":"text","url":"/docs/design-tokens/colors#what-changes-under-dark","content":"Primitive scales take their dark values from\ntokens/dark/colors.json. A scale class such as\ntext-grayscale-opacity-800 or bg-primary-500 switches on its own."},"332":{"id":"/docs/design-tokens/colors-29","page_id":"/docs/design-tokens/colors","tags":[],"type":"text","url":"/docs/design-tokens/colors#what-changes-under-dark","content":"Semantic tokens that alias a scale are rebuilt from the dark\nscale: primary → primary.500, foreground →\ngrayscale-opacity.900, border → grayscale-opacity.200."},"333":{"id":"/docs/design-tokens/colors-30","page_id":"/docs/design-tokens/colors","tags":[],"type":"text","url":"/docs/design-tokens/colors#what-changes-under-dark","content":"A few semantic tokens set their own dark value in\ntokens/dark/colors.json: background, card, and popover\n(#232327), and input (#444447)."},"334":{"id":"/docs/design-tokens/colors-31","page_id":"/docs/design-tokens/colors","tags":[],"type":"text","url":"/docs/design-tokens/colors#what-changes-under-dark","content":"These keep their light value: literal *-foreground whites,\nthe avatar and tag palettes below, and the shadow and\ngradient tokens on Effects."},"335":{"id":"/docs/design-tokens/colors-32","page_id":"/docs/design-tokens/colors","tags":[],"type":"text","url":"/docs/design-tokens/colors#what-changes-under-dark","content":"The .dark ancestor paints background and foreground, so text\nthat sits on the page uses the dark ink."},"336":{"id":"/docs/design-tokens/colors-33","page_id":"/docs/design-tokens/colors","tags":[],"type":"text","url":"/docs/design-tokens/colors#writing-components-for-both-modes","content":"Paper uses bg-background, not bg-white."},"337":{"id":"/docs/design-tokens/colors-34","page_id":"/docs/design-tokens/colors","tags":[],"type":"text","url":"/docs/design-tokens/colors#writing-components-for-both-modes","content":"When a fill turns light in dark mode, such as bg-grayscale-700 or\nbg-grayscale-opacity-700, put text-background on it so the text\nturns dark with it. Tag, Tooltip, and solid Toast do this."},"338":{"id":"/docs/design-tokens/colors-35","page_id":"/docs/design-tokens/colors","tags":[],"type":"text","url":"/docs/design-tokens/colors#writing-components-for-both-modes","content":"Child elements that fade the parent's text color use\ntext-current/90, not text-white/90."},"339":{"id":"/docs/design-tokens/colors-36","page_id":"/docs/design-tokens/colors","tags":[],"type":"text","url":"/docs/design-tokens/colors#writing-components-for-both-modes","content":"bg-white and text-white stay white. Use them for marks that must\nstay white, such as switch, slider, and radio thumbs, and for text on\nsaturated fills that keep one value in both modes."},"340":{"id":"/docs/design-tokens/colors-37","page_id":"/docs/design-tokens/colors","tags":[],"type":"text","url":"/docs/design-tokens/colors#writing-components-for-both-modes","content":"When a step lacks contrast in one mode, pick another step with the\ndark: variant. The data table selection bar uses\ntext-info-400 dark:text-info-200."},"341":{"id":"/docs/design-tokens/colors-38","page_id":"/docs/design-tokens/colors","tags":[],"type":"text","url":"/docs/design-tokens/colors#writing-components-for-both-modes","content":"Don't hardcode colors with arbitrary values such as\nbg-[#f8f8f9]. Use the nearest scale step."},"342":{"id":"/docs/design-tokens/colors-39","page_id":"/docs/design-tokens/colors","tags":[],"type":"text","url":"/docs/design-tokens/colors#primary","content":"The primary palette is a blue scale used for interactive elements,\nbuttons, focus states, and key affordances."},"343":{"id":"/docs/design-tokens/colors-40","page_id":"/docs/design-tokens/colors","tags":[],"type":"text","url":"/docs/design-tokens/colors#grayscale","content":"The default grayscale palette is fully solid — use it whenever the\nsurface must be opaque (popovers, tooltips, toasts, solid chips)."},"344":{"id":"/docs/design-tokens/colors-41","page_id":"/docs/design-tokens/colors","tags":[],"type":"text","url":"/docs/design-tokens/colors#grayscale-opacity","content":"The opacity variant uses rgba(35, 35, 50, α) so it tonally adapts\nover any background. Use it for hover tints, dividers, disabled fields,\nand other states where translucency is desired. --grayscale-opacity-900\nis the only solid hex."},"345":{"id":"/docs/design-tokens/colors-42","page_id":"/docs/design-tokens/colors","tags":[],"type":"text","url":"/docs/design-tokens/colors#success","content":"Positive feedback, confirmations, \"saved\" states."},"346":{"id":"/docs/design-tokens/colors-43","page_id":"/docs/design-tokens/colors","tags":[],"type":"text","url":"/docs/design-tokens/colors#info","content":"Informational messaging and neutral status indicators."},"347":{"id":"/docs/design-tokens/colors-44","page_id":"/docs/design-tokens/colors","tags":[],"type":"text","url":"/docs/design-tokens/colors#warning","content":"Caution states — soft warnings that don't block flow."},"348":{"id":"/docs/design-tokens/colors-45","page_id":"/docs/design-tokens/colors","tags":[],"type":"text","url":"/docs/design-tokens/colors#destructive","content":"Errors, destructive actions, hard validation failures."},"349":{"id":"/docs/design-tokens/colors-46","page_id":"/docs/design-tokens/colors","tags":[],"type":"text","url":"/docs/design-tokens/colors#semantic-tokens","content":"Intent-based aliases that point to primitive colors. Each surface\nships with a paired -foreground token — use them together so text\nremains legible regardless of theme overrides."},"350":{"id":"/docs/design-tokens/colors-47","page_id":"/docs/design-tokens/colors","tags":[],"type":"text","url":"/docs/design-tokens/colors#surfaces","content":"Page chrome, cards, popovers, and muted/accent regions. background\nis the page; card and popover are elevated containers; muted\nand accent are subtle background tints (e.g. table stripes, hover\nstates)."},"351":{"id":"/docs/design-tokens/colors-48","page_id":"/docs/design-tokens/colors","tags":[],"type":"text","url":"/docs/design-tokens/colors#actions","content":"Brand action surfaces. primary is the dominant call-to-action;\nsecondary is the alternative button surface."},"352":{"id":"/docs/design-tokens/colors-49","page_id":"/docs/design-tokens/colors","tags":[],"type":"text","url":"/docs/design-tokens/colors#status","content":"Feedback colors paired with foreground for legible content."},"353":{"id":"/docs/design-tokens/colors-50","page_id":"/docs/design-tokens/colors","tags":[],"type":"text","url":"/docs/design-tokens/colors#form","content":"Borders, input strokes, and focus rings. border is the 0.08 hairline\nfor dividers and single edges, and it is also the default color of a bare\nborder class. border-overlap is solid, for edges that stack or cross,\nsuch as avatar outlines in a group or tree rails, where a translucent line\nwould darken. input strokes form fields; ring paints focus outlines."},"354":{"id":"/docs/design-tokens/colors-51","page_id":"/docs/design-tokens/colors","tags":[],"type":"text","url":"/docs/design-tokens/colors#charts","content":"Five-step palette for data visualization. Defaults rotate through\nprimary → success → warning → info → destructive so chart series\ninherit brand color regardless of theme overrides."},"355":{"id":"/docs/design-tokens/colors-52","page_id":"/docs/design-tokens/colors","tags":[],"type":"text","url":"/docs/design-tokens/colors#sidebar","content":"Application sidebar shell slots (shadcn-compatible). Used by the\nSidebar primitive utilities such as\nbg-sidebar, text-sidebar-foreground, and border-sidebar-border.\nProduct blocks may override individual slots (for example\n[--sidebar:transparent] on the cloud shell)."},"356":{"id":"/docs/design-tokens/colors-53","page_id":"/docs/design-tokens/colors","tags":[],"type":"text","url":"/docs/design-tokens/colors#sidebar","content":"Slot"},"357":{"id":"/docs/design-tokens/colors-54","page_id":"/docs/design-tokens/colors","tags":[],"type":"text","url":"/docs/design-tokens/colors#sidebar","content":"Default alias"},"358":{"id":"/docs/design-tokens/colors-55","page_id":"/docs/design-tokens/colors","tags":[],"type":"text","url":"/docs/design-tokens/colors#sidebar","content":"--sidebar"},"359":{"id":"/docs/design-tokens/colors-56","page_id":"/docs/design-tokens/colors","tags":[],"type":"text","url":"/docs/design-tokens/colors#sidebar","content":"grayscale.100"},"360":{"id":"/docs/design-tokens/colors-57","page_id":"/docs/design-tokens/colors","tags":[],"type":"text","url":"/docs/design-tokens/colors#sidebar","content":"--sidebar-foreground"},"361":{"id":"/docs/design-tokens/colors-58","page_id":"/docs/design-tokens/colors","tags":[],"type":"text","url":"/docs/design-tokens/colors#sidebar","content":"grayscale.900"},"362":{"id":"/docs/design-tokens/colors-59","page_id":"/docs/design-tokens/colors","tags":[],"type":"text","url":"/docs/design-tokens/colors#sidebar","content":"--sidebar-primary"},"363":{"id":"/docs/design-tokens/colors-60","page_id":"/docs/design-tokens/colors","tags":[],"type":"text","url":"/docs/design-tokens/colors#sidebar","content":"primary.500"},"364":{"id":"/docs/design-tokens/colors-61","page_id":"/docs/design-tokens/colors","tags":[],"type":"text","url":"/docs/design-tokens/colors#sidebar","content":"--sidebar-primary-foreground"},"365":{"id":"/docs/design-tokens/colors-62","page_id":"/docs/design-tokens/colors","tags":[],"type":"text","url":"/docs/design-tokens/colors#sidebar","content":"white"},"366":{"id":"/docs/design-tokens/colors-63","page_id":"/docs/design-tokens/colors","tags":[],"type":"text","url":"/docs/design-tokens/colors#sidebar","content":"--sidebar-accent"},"367":{"id":"/docs/design-tokens/colors-64","page_id":"/docs/design-tokens/colors","tags":[],"type":"text","url":"/docs/design-tokens/colors#sidebar","content":"primary.50"},"368":{"id":"/docs/design-tokens/colors-65","page_id":"/docs/design-tokens/colors","tags":[],"type":"text","url":"/docs/design-tokens/colors#sidebar","content":"--sidebar-accent-foreground"},"369":{"id":"/docs/design-tokens/colors-66","page_id":"/docs/design-tokens/colors","tags":[],"type":"text","url":"/docs/design-tokens/colors#sidebar","content":"primary.700"},"370":{"id":"/docs/design-tokens/colors-67","page_id":"/docs/design-tokens/colors","tags":[],"type":"text","url":"/