ing","tags":[],"url":"/docs/components/sidebar#cookie--open-state","content":"Cookie / open state"},"2992":{"id":"/docs/components/sidebar-16","page_id":"/docs/components/sidebar","type":"heading","tags":[],"url":"/docs/components/sidebar#theme-css-variables","content":"Theme CSS variables"},"2993":{"id":"/docs/components/sidebar-17","page_id":"/docs/components/sidebar","type":"heading","tags":[],"url":"/docs/components/sidebar#mobile","content":"Mobile"},"2994":{"id":"/docs/components/sidebar-18","page_id":"/docs/components/sidebar","type":"heading","tags":[],"url":"/docs/components/sidebar#embedding-and-multiple-sidebars","content":"Embedding and multiple sidebars"},"2995":{"id":"/docs/components/sidebar-19","page_id":"/docs/components/sidebar","tags":[],"type":"text","url":"/docs/components/sidebar#preview","content":"BoundaryPrimitive: structure + behavior (collapse, cookie, ⌘B, mobile sheet) and shadcn-aligned data-slot / data-side / data-variant / data-state on every panel branch, plus a basic default skin (grayscale text and hover/active fill — not shadcn sidebar-accent). No product-only decorations such as the rail left bar.Product styles / full shells: Cloud — Flat, Inline Submenus, Collapsible Submenus, Dropdown Submenus, Secondary Nav, Header Actions.Colors: semantic slots --sidebar* (from tokens/semantic/color.json → generated.css) color the chrome. Menu item default skin stays grayscale-*. See Colors → Sidebar.SidebarProvider wraps children in TooltipProvider delay={0} (same as shadcn), so tooltips under SidebarInset also open immediately.Header / Footer “sticky” is flex pin: siblings of SidebarContent, not inside it. Only SidebarContent scrolls."},"2996":{"id":"/docs/components/sidebar-20","page_id":"/docs/components/sidebar","tags":[],"type":"text","url":"/docs/components/sidebar#usage","content":"Wrap your layout with SidebarProvider, compose the shell with Sidebar + SidebarInset, and build navigation with the menu parts. Basic styles come free; use a block or className for product-specific skins."},"2997":{"id":"/docs/components/sidebar-21","page_id":"/docs/components/sidebar","tags":[],"type":"text","url":"/docs/components/sidebar#structure","content":"Part"},"2998":{"id":"/docs/components/sidebar-22","page_id":"/docs/components/sidebar","tags":[],"type":"text","url":"/docs/components/sidebar#structure","content":"Role"},"2999":{"id":"/docs/components/sidebar-23","page_id":"/docs/components/sidebar","tags":[],"type":"text","url":"/docs/components/sidebar#structure","content":"SidebarProvider"},"3000":{"id":"/docs/components/sidebar-24","page_id":"/docs/components/sidebar","tags":[],"type":"text","url":"/docs/components/sidebar#structure","content":"Collapsible state, cookie (cookieName), keyboard shortcut (enableKeyboardShortcut), mobile check (isMobile)"},"3001":{"id":"/docs/components/sidebar-25","page_id":"/docs/components/sidebar","tags":[],"type":"text","url":"/docs/components/sidebar#structure","content":"Sidebar"},"3002":{"id":"/docs/components/sidebar-26","page_id":"/docs/components/sidebar","tags":[],"type":"text","url":"/docs/components/sidebar#structure","content":"Main panel (side, variant, collapsible, render)"},"3003":{"id":"/docs/components/sidebar-27","page_id":"/docs/components/sidebar","tags":[],"type":"text","url":"/docs/components/sidebar#structure","content":"SidebarTrigger / SidebarRail"},"3004":{"id":"/docs/components/sidebar-28","page_id":"/docs/components/sidebar","tags":[],"type":"text","url":"/docs/components/sidebar#structure","content":"Toggle controls"},"3005":{"id":"/docs/components/sidebar-29","page_id":"/docs/components/sidebar","tags":[],"type":"text","url":"/docs/components/sidebar#structure","content":"SidebarInset"},"3006":{"id":"/docs/components/sidebar-30","page_id":"/docs/components/sidebar","tags":[],"type":"text","url":"/docs/components/sidebar#structure","content":"Primary content region"},"3007":{"id":"/docs/components/sidebar-31","page_id":"/docs/components/sidebar","tags":[],"type":"text","url":"/docs/components/sidebar#structure","content":"SidebarHeader / SidebarFooter / SidebarContent"},"3008":{"id":"/docs/components/sidebar-32","page_id":"/docs/components/sidebar","tags":[],"type":"text","url":"/docs/components/sidebar#structure","content":"Sticky header/footer and scrollable body"},"3009":{"id":"/docs/components/sidebar-33","page_id":"/docs/components/sidebar","tags":[],"type":"text","url":"/docs/components/sidebar#structure","content":"SidebarGroup*"},"3010":{"id":"/docs/components/sidebar-34","page_id":"/docs/components/sidebar","tags":[],"type":"text","url":"/docs/components/sidebar#structure","content":"Labeled sections inside content"},"3011":{"id":"/docs/components/sidebar-35","page_id":"/docs/components/sidebar","tags":[],"type":"text","url":"/docs/components/sidebar#structure","content":"SidebarMenu*"},"3012":{"id":"/docs/components/sidebar-36","page_id":"/docs/components/sidebar","tags":[],"type":"text","url":"/docs/components/sidebar#structure","content":"Navigation rows, actions, badges, skeletons, nested submenus"},"3013":{"id":"/docs/components/sidebar-37","page_id":"/docs/components/sidebar","tags":[],"type":"text","url":"/docs/components/sidebar#collapsible-modes","content":"offcanvas (default) — hides off-screen when collapsed"},"3014":{"id":"/docs/components/sidebar-38","page_id":"/docs/components/sidebar","tags":[],"type":"text","url":"/docs/components/sidebar#collapsible-modes","content":"icon — collapses to an icon rail; menu labels hide; tooltip shows on hover"},"3015":{"id":"/docs/components/sidebar-39","page_id":"/docs/components/sidebar","tags":[],"type":"text","url":"/docs/components/sidebar#collapsible-modes","content":"none — fixed width, not collapsible"},"3016":{"id":"/docs/components/sidebar-40","page_id":"/docs/components/sidebar","tags":[],"type":"text","url":"/docs/components/sidebar#collapsible-modes","content":"With offcanvas, the trigger slides the whole panel out of view:"},"3017":{"