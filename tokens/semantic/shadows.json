{
  "shadow": {
    "accent":    { "$value": "0 2px 8px 0 rgba(35, 35, 50, 0.15)",  "$type": "string" },
    "base":      { "$value": "0 6px 10px 0 rgba(35, 35, 50, 0.08)", "$type": "string" },
    "emphasis":  { "$value": "0 6px 20px -2px rgba(35, 35, 50, 0.25)", "$type": "string" },
    "top-level": { "$value": "0 6px 32px -4px rgba(35, 35, 50, 0.25)", "$type": "string" },

    "focus-primary":     { "$value": "0 0 0 2px {primary.200}",     "$type": "string" },
    "focus-success":     { "$value": "0 0 0 2px {success.200}",     "$type": "string" },
    "focus-info":        { "$value": "0 0 0 2px {info.200}",        "$type": "string" },
    "focus-warning":     { "$value": "0 0 0 2px {warning.200}",     "$type": "string" },
    "focus-destructive": { "$value": "0 0 0 2px {destructive.200}", "$type": "string" },

    "focus-ring-primary":     { "$value": "0 0 0 2px rgba(14, 134, 254, 0.2)", "$type": "string" },
    "focus-ring-destructive": { "$value": "0 0 0 2px rgba(235, 80, 0, 0.2)",   "$type": "string" },

    "button-primary":            { "$value": "0 6px 10px rgba(14, 134, 254, 0.3)",  "$type": "string" },
    "button-primary-active":     { "$value": "0 2px 4px rgba(14, 134, 254, 0.4)",   "$type": "string" },
    "button-success":            { "$value": "0 6px 10px rgba(43, 205, 134, 0.3)",  "$type": "string" },
    "button-success-active":     { "$value": "0 2px 4px rgba(43, 205, 134, 0.4)",   "$type": "string" },
    "button-info":               { "$value": "0 6px 10px rgba(0, 195, 255, 0.3)",   "$type": "string" },
    "button-info-active":        { "$value": "0 2px 4px rgba(0, 195, 255, 0.4)",    "$type": "string" },
    "button-warning":            { "$value": "0 6px 10px rgba(255, 167, 0, 0.3)",   "$type": "string" },
    "button-warning-active":     { "$value": "0 2px 4px rgba(255, 167, 0, 0.4)",    "$type": "string" },
    "button-destructive":        { "$value": "0 6px 10px rgba(235, 80, 0, 0.3)",    "$type": "string" },
    "button-destructive-active": { "$value": "0 2px 4px rgba(235, 80, 0, 0.4)",     "$type": "string" }
  }
}
