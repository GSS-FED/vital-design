{
  "name": "@fed/vital-design",
  "private": false,
  "version": "0.5.0",
  "author": "Arthur Lu <arthur_lu@gss.com.tw>",
  "type": "module",
  "main": "dist/vital-design.js",
  "types": "dist/types.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "@fed:registry": "https://git.gss.com.tw/api/v4/projects/5615/packages/npm/"
  },
  "scripts": {
    "prepare": "husky install",
    "dev": "pnpm run storybook:dev",
    "dev:portless": "portless --script storybook:dev",
    "build": "tsc && vite build",
    "lint": "eslint . --ext cjs,js,jsx,mjs,ts,tsx --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write \"**/**.{cjs,js,jsx,mjs,ts,tsx}\" --ignore-path .gitignore",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "storybook:dev": "storybook dev -p ${PORT:-6006}",
    "tokens:build": "node --import tsx ./scripts/build-tokens.ts",
    "tokens:build:css": "node --import tsx ./scripts/build-tokens.ts css",
    "icons:build": "tsx scripts/build-icons.ts && prettier --write \"src-v2/icons/*.tsx\" --log-level warn",
    "registry:generate": "tsx scripts/build-registry-json.ts",
    "registry:build": "pnpm run icons:build && pnpm run tokens:build && tsx scripts/build-registry-json.ts && shadcn build",
    "registry:validate": "tsx scripts/validate-registry.ts",
    "storybook:build": "pnpm run registry:build && storybook build",
    "prepublishOnly": "pnpm run build",
    "release": "semantic-release",
    "docs:dev": "pnpm --filter @fed/vital-docs dev",
    "docs:dev:portless": "cd apps/docs && portless",
    "docs:lint": "pnpm --filter @fed/vital-docs lint",
    "docs:copy-registry": "mkdir -p apps/docs/public/r && cp public/r/*.json apps/docs/public/r/",
    "docs:build": "pnpm run registry:build && pnpm run docs:copy-registry && pnpm --filter @fed/vital-docs build",
    "docs:start": "npx serve apps/docs/out"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.8",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.0.4",
    "@radix-ui/react-icons": "^1.3.0",
    "@radix-ui/react-radio-group": "^1.1.3",
    "@radix-ui/react-switch": "^1.0.3",
    "polished": "^4.2.2",
    "react-window": "^1.8.11",
    "react-window-infinite-loader": "^1.0.9"
  },
  "devDependencies": {
    "@base-ui/react": "^1.6.0",
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@radix-ui/themes": "^3.1.4",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/gitlab": "^12.1.1",
    "@storybook/addon-essentials": "^8.4.5",
    "@storybook/addon-interactions": "^8.4.5",
    "@storybook/addon-links": "^8.4.5",
    "@storybook/blocks": "^8.4.5",
    "@storybook/preview-api": "^8.4.5",
    "@storybook/react": "^8.4.5",
    "@storybook/react-vite": "^8.4.5",
    "@storybook/test": "^8.4.5",
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@svgr/plugin-svgo": "^8.1.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-table": "^8.21.3",
    "@testing-library/jest-dom": "^6.3.0",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.2",
    "@trivago/prettier-plugin-sort-imports": "^4.3.0",
    "@types/node": "^20.11.10",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@types/react-window": "^1.8.8",
    "@types/react-window-infinite-loader": "^1.0.9",
    "@types/styled-components": "^5.1.34",
    "@typescript-eslint/eslint-plugin": "^6.19.1",
    "@typescript-eslint/parser": "^6.19.1",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^1.4.0",
    "agentation": "^3.0.2",
    "autoprefixer": "^10.4.23",
    "babel-plugin-styled-components": "^2.1.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "^4.1.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jest-dom": "^5.1.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "eslint-plugin-storybook": "^0.6.15",
    "eslint-plugin-testing-library": "^6.2.0",
    "husky": "^8.0.3",
    "jsdom": "^23.2.0",
    "lint-staged": "^15.2.0",
    "postcss": "^8.5.6",
    "prettier": "^3.2.4",
    "react": "^18.2.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^18.2.0",
    "react-resizable-panels": "^4.10.0",
    "semantic-release": "^22.0.12",
    "shadcn": "^4.15.0",
    "storybook": "^8.4.5",
    "style-dictionary": "^5.4.0",
    "styled-components": "^5.3.11",
    "svgo": "^4.0.1",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.19.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^3.7.2",
    "vitest": "^1.4.0"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "styled-components": ">= 5"
  },
  "packageManager": "pnpm@10.17.1+sha512.17c560fca4867ae9473a3899ad84a88334914f379be46d455cbf92e5cf4b39d34985d452d2583baf19967fa76cb5c17bc9e245529d0b98745721aa7200ecaf7a",
  "portless": {
    "name": "storybook.vital-design",
    "script": "storybook:dev"
  }
}
