{
  "_comment": "UI 元件模板 (registry:ui)",
  "ui-template": {
    "name": "<component-name>",
    "type": "registry:ui",
    "title": "<ComponentName>",
    "description": "元件描述",
    "dependencies": ["clsx", "tailwind-merge"],
    "registryDependencies": [
      "@vital-design/utils",
      "@vital-design/vital-theme"
    ],
    "files": [
      {
        "path": "src-v2/components/<component-name>/<ComponentName>.tsx",
        "type": "registry:ui"
      }
    ]
  },

  "_comment2": "Block 模板 (registry:block)",
  "block-template": {
    "name": "<block-name>",
    "type": "registry:block",
    "title": "<Block Name>",
    "description": "區塊描述",
    "categories": ["category1", "category2"],
    "dependencies": ["clsx", "tailwind-merge"],
    "registryDependencies": [
      "@vital-design/utils",
      "@vital-design/button"
    ],
    "files": [
      {
        "path": "src-v2/blocks/<block-name>/<BlockName>.tsx",
        "type": "registry:component"
      }
    ]
  },

  "_comment3": "常見 registryDependencies 對照表",
  "dependency-map": {
    "Button": "@vital-design/button",
    "Avatar": "@vital-design/avatar",
    "SearchBar": "@vital-design/search-bar",
    "Select": "@vital-design/select",
    "Chip": "@vital-design/chip",
    "Tag": "@vital-design/tag",
    "Switch": "@vital-design/switch",
    "TextInput": "@vital-design/text-input",
    "PasswordInput": "@vital-design/password-input",
    "Checkbox": "@vital-design/checkbox",
    "cn()": "@vital-design/utils",
    "Theme CSS vars": "@vital-design/vital-theme",
    "Specific icon": "@vital-design/icon-<icon-name>",
    "All icons bundle": "@vital-design/vital-icons"
  }
}
