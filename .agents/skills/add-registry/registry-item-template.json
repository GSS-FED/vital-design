{
  "_comment": "UI 元件模板 (registry:ui)",
  "ui-template": {
    "name": "<component-name>",
    "type": "registry:ui",
    "title": "<ComponentName>",
    "description": "元件描述",
    "dependencies": ["cn"],
    "registryDependencies": [
      "@vital-design/utils",
      "@vital-design/vital-theme"
    ],
    "files": [
      {
        "path": "src-v2/components/<component-name>/<ComponentName>.tsx",
        "type": "registry:ui"
      }
    ]
  },

  "_comment2": "Block 模板 (registry:block)",
  "block-template": {
    "name": "<block-name>",
    "type": "registry:block",
    "title": "<Block Name>",
    "description": "區塊描述",
    "categories": ["category1", "category2"],
    "dependencies": ["cn"],
    "registryDependencies": [
      "@vital-design/utils",
      "@vital-design/button"
    ],
    "files": [
      {
        "path": "src-v2/blocks/<block-name>/<BlockName>.tsx",
        "type": "registry:component"
      }
    ]
  },

  "_comment3": "常見 registryDependencies 對照表",
  "dependency-map": {
    "Alert": "@vital-design/alert",
    "Autocomplete": "@vital-design/autocomplete",
    "Avatar": "@vital-design/avatar",
    "Badge": "@vital-design/badge",
    "Button": "@vital-design/button",
    "ButtonGroup": "@vital-design/button-group",
    "Calendar": "@vital-design/calendar",
    "Card": "@vital-design/card",
    "Checkbox": "@vital-design/checkbox",
    "Chip": "@vital-design/chip",
    "Collapsible": "@vital-design/collapsible",
    "Combobox": "@vital-design/combobox",
    "Command": "@vital-design/command",
    "Dialog": "@vital-design/dialog",
    "DropdownMenu": "@vital-design/dropdown-menu",
    "Editable": "@vital-design/editable",
    "Field": "@vital-design/field",
    "Input": "@vital-design/input",
    "InputGroup": "@vital-design/input-group",
    "Item": "@vital-design/item",
    "Label": "@vital-design/label",
    "NumberInput": "@vital-design/number-input",
    "PasswordInput": "@vital-design/password-input",
    "Popover": "@vital-design/popover",
    "Progress": "@vital-design/progress",
    "RadioGroup": "@vital-design/radio-group",
    "Resizable": "@vital-design/resizable",
    "ScrollArea": "@vital-design/scroll-area",
    "SearchBar": "@vital-design/search-bar",
    "Select": "@vital-design/select",
    "Separator": "@vital-design/separator",
    "Sheet": "@vital-design/sheet",
    "Sidebar": "@vital-design/sidebar",
    "Skeleton": "@vital-design/skeleton",
    "Slider": "@vital-design/slider",
    "Spinner": "@vital-design/spinner",
    "SplitButton": "@vital-design/split-button",
    "Switch": "@vital-design/switch",
    "Table": "@vital-design/table",
    "Tabs": "@vital-design/tabs",
    "Tag": "@vital-design/tag",
    "Textarea": "@vital-design/textarea",
    "TimePicker": "@vital-design/time-picker",
    "Toast": "@vital-design/toast",
    "Toolbar": "@vital-design/toolbar",
    "Tooltip": "@vital-design/tooltip",
    "cn()": "@vital-design/utils",
