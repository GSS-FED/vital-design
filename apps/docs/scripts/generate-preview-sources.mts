// Builds the source map the Code tab in <ComponentPreview /> reads, at
// apps/docs/components/previews/__sources__.ts, from:
// docs examples, src-v2/**/examples/*.tsx: the whole file, keyed by each
// `export function XxxExample`.
// Repo imports are rewritten to the paths a registry install produces.
//
// We also pre-bake Shiki highlighting at generation time so the runtime
// doesn't have to do server-side highlighting per page — keeps
// ComponentPreview as a client component (examples use 'use client').
import {
  mkdirSync,
  readFileSync,
  readdirSync,
  writeFileSync,
} from 'node:fs';
import { dirname, join } from 'node:path';
import { fileURLToPath } from 'node:url';
import { codeToHtml } from 'shiki';

const __dirname = dirname(fileURLToPath(import.meta.url));
const previewsDir = join(__dirname, '..', 'components', 'previews');
const outFile = join(previewsDir, '__sources__.ts');

const sources: Record<string, string> = {};

const toInstalledImports = (code: string) =>
  code
    .replace(
      /(['"])@\/components\/(?:[^/'"]+\/)*([^/'"]+)\1/g,
      '$1@/components/ui/$2$1',
    )
    .replace(
      /(['"])@\/icons\/([^'"]+)\1/g,
      '$1@/components/icons/$2$1',
    )
    // Blocks install to src/blocks/<name>/<file> (registry/blocks.ts).
    .replace(
      /(['"])@\/blocks\/([^/'"]+)\/components\/([^'"]+)\1/g,
      '$1@/blocks/$2/$3$1',
    );

const srcDir = join(__dirname, '..', '..', '..', 'src-v2');
for (const file of readdirSync(srcDir, {
  recursive: true,
}) as string[]) {
  if (!/(^|\/)examples\/\w+\.tsx$/.test(file)) continue;
  const raw = readFileSync(join(srcDir, file), 'utf-8');
  const code = toInstalledImports(
    raw.replace(/^'use client';\n\n/, ''),
  ).trimEnd();
  for (const [, name] of raw.matchAll(
    /export function (\w+Example)\b/g,
  )) {
    if (sources[name]) {
      throw new Error(`Two examples export ${name} (src-v2/${file})`);
    }
    sources[name] = code;
  }
}

const sortedKeys = Object.keys(sources).sort();

// Pre-highlight each source with shiki so ComponentPreview doesn't have to
// at runtime. Strip Shiki's own background — the docs container sets it.
const entries = await Promise.all(
  sortedKeys.map(async (name) => {
    const code = sources[name];
    let html = await codeToHtml(code, {
      lang: 'tsx',
      theme: 'github-light',
    });
    html = html.replace(
      /style="background-color:[^"]+;color:/,
      'style="color:',
    );
    return [name, { source: code, html }] as const;
  }),
);

const banner = `// Auto-generated by scripts/generate-preview-sources.mts.\n// Run \`pnpm previews:sources\` to regenerate.\n\n`;
const body =
  'export type PreviewSource = { source: string; html: string };\n\n' +
  'export const previewSources: Record<string, PreviewSource> = {\n' +
  entries
    .map(
      ([name, value]) =>
        `  ${JSON.stringify(name)}: {\n    source: ${JSON.stringify(
          value.source,
        )},\n    html: ${JSON.stringify(value.html)},\n  },`,
    )
    .join('\n') +
  '\n};\n';

// The folder only holds this generated (gitignored) file, so a fresh
// checkout doesn't have it.
mkdirSync(previewsDir, { recursive: true });
writeFileSync(outFile, banner + body);

console.log(
  `Generated ${sortedKeys.length} preview sources into ${outFile}`,
);
