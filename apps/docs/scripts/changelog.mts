// The docs changelog is one pair of files per entry in content/changelog/,
// so merge requests add files instead of all editing the top of one page.
//
//   build        Joins _intro and the entries into content/docs/changelog.mdx
//                and changelog.zh-tw.mdx (gitignored): a ## heading per
//                month, then each entry's title as ###, newest first. Fails
//                when an entry lacks its other language, a title, or a body,
//                or uses a heading above ####.
//   new <slug>   Creates YYYY-MM-DD-HHmm-<slug>.mdx and .zh-tw.mdx stamped
//                with the current Asia/Taipei time.
//
// The file name's date picks the month group; the time orders entries
// within it.
import {
  existsSync,
  readFileSync,
  readdirSync,
  writeFileSync,
} from 'node:fs';
import { dirname, join } from 'node:path';
import { fileURLToPath } from 'node:url';

const docsRoot = join(dirname(fileURLToPath(import.meta.url)), '..');
const entriesDir = join(docsRoot, 'content', 'changelog');
const outDir = join(docsRoot, 'content', 'docs');

const ENTRY =
  /^(\d{4})-(\d{2})-(\d{2})-(\d{4})-([a-z0-9]+(?:-[a-z0-9]+)*)\.mdx$/;
const FRONTMATTER = /^---\ntitle: (.+)\n---\n/;
const EN_MONTHS = [
  'January',
  'February',
  'March',
  'April',
  'May',
  'June',
  'July',
  'August',
  'September',
  'October',
  'November',
  'December',
];

function read(file: string): string {
  return readFileSync(join(entriesDir, file), 'utf-8').replace(
    /\r\n/g,
    '\n',
  );
}

function entryParts(file: string, errors: string[]) {
  const source = read(file);
  const match = FRONTMATTER.exec(source);
  if (!match) {
    errors.push(
      `${file}: start with front matter that has only "title: ..."`,
    );
    return undefined;
  }
  const body = source.slice(match[0].length).trim();
  if (!body.replace(/\{\/\*[\s\S]*?\*\/\}/g, '').trim()) {
    errors.push(`${file}: write the entry below the front matter`);
    return undefined;
  }
  // ## is the month and ### the entry title, so the body starts at ####.
  let inFence = false;
  for (const line of body.split('\n')) {
    if (line.startsWith('```')) inFence = !inFence;
    else if (!inFence && /^#{1,3} /.test(line)) {
      errors.push(`${file}: use #### or deeper for "${line}"`);
      return undefined;
    }
  }
  return { title: match[1].trim(), body };
}

function build() {
  const files = readdirSync(entriesDir).filter(
    (f) => !f.startsWith('_'),
  );
  const errors: string[] = [];
  const en: string[] = [];
  const zh: string[] = [];
  let lastMonth = '';

  for (const file of files) {
    const base = file.replace(/\.zh-tw\.mdx$/, '.mdx');
    if (!ENTRY.test(base)) {
      errors.push(
        `${file}: name it YYYY-MM-DD-HHmm-<slug>.mdx (or .zh-tw.mdx)`,
      );
    } else if (
      !files.includes(base.replace(/\.mdx$/, '.zh-tw.mdx'))
    ) {
      errors.push(
        `${file}: add ${base.replace(/\.mdx$/, '.zh-tw.mdx')}`,
      );
    } else if (!files.includes(base)) {
      errors.push(`${file}: add ${base}`);
    }
  }

  const entries = files
    .filter((f) => ENTRY.test(f))
    .sort()
    .reverse();
  for (const file of entries) {
    const zhFile = file.replace(/\.mdx$/, '.zh-tw.mdx');
    if (!files.includes(zhFile)) continue;
    const [, year, month] = ENTRY.exec(file)!;
    const enEntry = entryParts(file, errors);
    const zhEntry = entryParts(zhFile, errors);
    if (!enEntry || !zhEntry) continue;
    if (`${year}-${month}` !== lastMonth) {
      lastMonth = `${year}-${month}`;
      en.push(`## ${EN_MONTHS[Number(month) - 1]} ${year}`);
      zh.push(`## ${year} 年 ${Number(month)} 月`);
    }
    en.push(`### ${enEntry.title}\n\n${enEntry.body}`);
    zh.push(`### ${zhEntry.title}\n\n${zhEntry.body}`);
  }

  if (errors.length > 0) {
    console.error(
      `Changelog entries in ${entriesDir}:\n${errors.map((e) => `  ${e}`).join('\n')}`,
    );
    process.exit(1);
  }

  const notice =
    '{/* Generated by `pnpm changelog:build` from content/changelog/. Edit those files, not this one. */}';
  const write = (name: string, intro: string, sections: string[]) =>
    writeFileSync(
      join(outDir, name),
      `${intro.trimEnd()}\n\n${notice}\n\n${sections.join('\n\n')}\n`,
    );
  write('changelog.mdx', read('_intro.mdx'), en);
  write('changelog.zh-tw.mdx', read('_intro.zh-tw.mdx'), zh);
  console.log(`changelog: ${entries.length} entries`);
}

function create(slug: string | undefined) {
  if (!slug || !/^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(slug)) {
    console.error('Usage: pnpm changelog:new <kebab-case-slug>');
    process.exit(1);
  }
  const parts = Object.fromEntries(
    new Intl.DateTimeFormat('en-CA', {
      timeZone: 'Asia/Taipei',
      year: 'numeric',
      month: '2-digit',
      day: '2-digit',
      hour: '2-digit',
      minute: '2-digit',
      hourCycle: 'h23',
    })
      .formatToParts(new Date())
      .map((p) => [p.type, p.value]),
  );
  const base = `${parts.year}-${parts.month}-${parts.day}-${parts.hour}${parts.minute}-${slug}`;
  const title = slug
    .split('-')
    .map((w) => w[0].toUpperCase() + w.slice(1))
    .join(' ');
  const templates = {
    [`${base}.mdx`]:
      '{/* What changed for people who install or use the registry, and what they need to do. */}',
    [`${base}.zh-tw.mdx`]:
      '{/* 對安裝或使用 registry 的人有什麼改變、他們要做什麼。 */}',
  };
  for (const [file, hint] of Object.entries(templates)) {
    const path = join(entriesDir, file);
    if (existsSync(path)) {
      console.error(`${path} already exists`);
      process.exit(1);
    }
    writeFileSync(path, `---\ntitle: ${title}\n---\n\n${hint}\n`);
    console.log(`created ${path}`);
  }
}

const [command, arg] = process.argv.slice(2);
if (command === 'build') build();
else if (command === 'new') create(arg);
else {
  console.error('Usage: changelog.mts build | new <slug>');
  process.exit(1);
}
