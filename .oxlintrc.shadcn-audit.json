{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./.oxlintrc.shadcn.json"],
  "settings": {
    "shadcn": {
      "ui": "@/components",
      "ignoreImports": ["^@/components/collapsible(/|$)"]
    }
  },
  "overrides": [
    {
      "files": ["src-v2/blocks/**"],
      "rules": {
        "shadcn/no-restyle": [
          "warn",
          {
            "allow": ["layout"],
            "contracts": [
              {
                "pattern": "(Group|Header|Footer|Content|MenuItem)$|^Toolbar$",
                "allow": ["layout", "spacing"]
              },
              {
                "pattern": "^Skeleton$",
                "allow": ["layout", "shape"]
              },
              {
                "pattern": "^Label$",
                "allow": ["layout", "typography"]
              },
              {
                "pattern": "^Table$",
                "allow": [
                  "layout",
                  "rounded",
                  "border-w",
                  "border-color",
                  "bg-color",
                  "shadow"
                ]
              },
              {
                "pattern": "^ProgressSegment$",
                "allow": ["layout", "bg-color"]
              },
              {
                "pattern": "^ProgressSegments$",
                "allow": ["layout", "gap"]
              },
              {
                "pattern": "^(Button|DialogTitle|SheetTitle)$",
                "allow": ["layout", "text-transform"]
              }
            ]
          }
        ]
      }
    }
  ]
}
